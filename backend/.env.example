# Copy to .env and fill in. .env is ignored by git.
# Login. Set with: uv run python -m pinpoint.auth set-password
APP_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=false

DATABASE_URL=postgresql+psycopg://pinpoint:CHANGE_ME@localhost:5432/pinpoint
TEST_DATABASE_URL=postgresql+psycopg://pinpoint:CHANGE_ME@localhost:5432/pinpoint_test

# External services. Leave empty to use the built-in mocks.
GOOGLE_MAPS_API_KEY=
DEEPSEEK_API_KEY=
META_APP_SECRET=
INSTAGRAM_USER_ID=

# Contact named in the scraper's user agent (an email or URL). Optional, but polite.
SCRAPER_CONTACT=

# Reddit Data API: create a "script" app at https://www.reddit.com/prefs/apps. Empty skips Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# Brave Search API key, to find travel blogs: https://brave.com/search/api/. Empty skips blogs.
BRAVE_SEARCH_API_KEY=
